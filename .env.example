# Copy to `.env.local` for local dev (only PUBLIC values — never put secrets here,
# anything VITE_* is shipped to the browser).

# PostHog public project key + ingestion host (EU cloud).
VITE_POSTHOG_KEY=phc_vwZrEoPt7x9cosJTBSvYsJA7VNgJtv679oviK2mmvwha
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Admin API Worker URL. Local: http://localhost:8787 (the Bun dev-server).
# Prod: the Worker's same-site custom domain https://api.bio.smartsquad.io (set as a GitHub repo Variable).
# It MUST be a subdomain of the primary site domain — a *.workers.dev URL is cross-site, so Safari blocks the
# session cookie and every authenticated call 401s.
VITE_ADMIN_API=http://localhost:8787
